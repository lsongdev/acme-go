{
  "name": "@lsongdev/stylesheets",
  "version": "1.2.0",
  "description": "Semantic-token CSS components: plain stylesheets, no build step to use them.",
  "license": "MIT",
  "type": "module",
  "style": "dist/stylesheets.css",
  "exports": {
    ".": "./dist/stylesheets.css",
    "./dist/*": "./dist/*",
    "./theme/*": "./theme/*",
    "./*.css": "./*.css",
    "./package.json": "./package.json"
  },
  "files": ["*.css", "theme/", "dist/"],
  "scripts": {
    "build": "node tools/bundle.js",
    "prepack": "node tools/bundle.js"
  },
  "repository": { "type": "git", "url": "git+https://github.com/lsongdev/stylesheets.git" }
}
